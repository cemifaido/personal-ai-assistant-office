# Configurazione Prototipo Office Add-in Multi-Modello
# Inserisci le chiavi API dei modelli che desideri utilizzare:

# 1. Google Gemini (Gratuito su aistudio.google.com)
GEMINI_API_KEY=

# 2. OpenAI / ChatGPT / Codex (platform.openai.com)
OPENAI_API_KEY=

# 3. Anthropic Claude (console.anthropic.com)
ANTHROPIC_API_KEY=

PORT=3000
