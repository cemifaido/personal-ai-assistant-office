# Segreti: mai nel repository
.env
_obsoleto/.env
_obsoleto/certs/
*.pfx
*.key

# Generato da installa.ps1 (contiene l'URL locale di pubblicazione)
manifest/

# File dell'Orchestratore LLM (dati/config locali, il codice resta centrale)
dati_locali/orchestrazione/
schema/evento.v1.json
schema/compito.v1.json
config/comandi.json
config/comandi.esempio.json

# Istruzioni per assistenti AI (sincronizzazione multi-agente via registro):
# locali per operatore/macchina, non condivise nel repository.
CLAUDE.md
GEMINI.md
AGENTS.md
AGENTS.codex.md
AGENTS.override.md

# Spike: output di compilazione e installatori
spike/**/bin/
spike/**/obj/
spike/**/out/
*.user

# Output di compilazione add-in Outlook e installatore
outlook/**/bin/
outlook/**/obj/
release/
build/

# Vecchia architettura (server Node) e script di sviluppo superati: solo in locale
_obsoleto/

# Documentazione tecnica interna (non pubblicata)
docs/ARCHITETTURA.md
